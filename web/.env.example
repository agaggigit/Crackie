# Salin ke web/.env.local (lokal) atau isi di environment variable Vercel.
# Jangan pernah commit nilai asli.

# --- Chain (FE + BE) ---
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Agent + Backend (docs/prd/be.md Bagian 3.9) ---
AGENT_PRIVATE_KEY=
RPC_URL_CADANGAN=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
# Naikkan (1 → 2 → 3) setelah jebol saat gladi, lalu pemilik memanggil nyalakanLagi(sidik jari baru)
AGENT_VERSI=1
LLM_API_KEY=
LLM_PROVIDER_CADANGAN=google
LLM_MODEL_CADANGAN=gemini-3.5-flash-lite
LLM_API_KEY_CADANGAN=
BATAS_TOKEN_HARIAN=200000
BATAS_PANJANG_PESAN=2000
GAS_LIMIT_BAYAR=550000
ADMIN_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hanya lokal, selama JebolVault belum tersambung: 1 = tool bayar PALSU tanpa chain
# dan tanpa verifikasi hash (respons ditandai `palsu: true`). Diabaikan di Vercel.
BAYAR_PALSU=
# Hanya lokal (anvil): alamat JebolVaultTiruan. Diisi otomatis oleh npm run dev:anvil.
JEBOL_VAULT_ALAMAT=

# --- Faucet (docs/prd/fe.md Bagian 3.8) ---
FAUCET_PRIVATE_KEY=
FAUCET_JUMLAH=0.05
FAUCET_BATAS_HARIAN=
